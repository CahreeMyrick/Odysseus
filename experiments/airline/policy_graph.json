{
  "directed": true,
  "multigraph": true,
  "graph": {
    "name": "Airline cancellation policy"
  },
  "nodes": [
    {
      "type": "Entity",
      "description": "Airline booking",
      "id": "Reservation"
    },
    {
      "type": "Entity",
      "description": "Passenger who can authorize cancellation",
      "id": "Passenger"
    },
    {
      "type": "Entity",
      "description": "Authoritative reservation records",
      "id": "ReservationDatabase"
    },
    {
      "type": "Attribute",
      "description": "Current reservation status",
      "data_type": "enum",
      "id": "ReservationStatus"
    },
    {
      "type": "Attribute",
      "description": "Refund eligibility flag",
      "data_type": "bool",
      "id": "Refundable"
    },
    {
      "type": "Attribute",
      "description": "Time remaining before departure",
      "data_type": "number",
      "id": "HoursUntilDeparture"
    },
    {
      "type": "Attribute",
      "description": "Unique reservation identifier",
      "data_type": "string",
      "id": "ReservationID"
    },
    {
      "type": "Value",
      "description": "Active reservation",
      "value": "confirmed",
      "id": "Confirmed"
    },
    {
      "type": "Value",
      "description": "Cancelled reservation",
      "value": "cancelled",
      "id": "Cancelled"
    },
    {
      "type": "Action",
      "description": "Retrieve a reservation",
      "id": "LookupReservation"
    },
    {
      "type": "Action",
      "description": "Cancel a reservation",
      "id": "CancelReservation"
    },
    {
      "type": "Condition",
      "description": "Reservation exists",
      "predicate": "exists(reservation_id)",
      "id": "Exists"
    },
    {
      "type": "Condition",
      "description": "Reservation is confirmed",
      "attribute": "ReservationStatus",
      "operator": "==",
      "value": "confirmed",
      "id": "IsConfirmed"
    },
    {
      "type": "Condition",
      "description": "Reservation is refundable",
      "attribute": "Refundable",
      "operator": "==",
      "value": true,
      "id": "IsRefundable"
    },
    {
      "type": "Condition",
      "description": "Departure is more than 24 hours away",
      "attribute": "HoursUntilDeparture",
      "operator": ">",
      "value": 24,
      "id": "DepartureBeyond24Hours"
    },
    {
      "type": "Condition",
      "description": "Passenger explicitly confirmed this cancellation",
      "predicate": "explicit_confirmation(reservation_id)",
      "id": "HasAuthorization"
    }
  ],
